---
import Base from "../layouts/Base.astro";
import CircuitDivider from "../components/CircuitDivider.astro";
import Bike from "../components/Bike.astro";
import { rides } from "../data/rides";
const sorted = [...rides].sort((a, b) => +new Date(b.date) - +new Date(a.date));
---
<Base title="rides" description="Where I've ridden, and the stories along the way.">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <div class="flex items-end justify-between gap-4">
    <h1 class="text-2xl font-bold text-sage-100">// rides</h1>
    <span class="text-sm text-muted">{rides.length} logged</span>
  </div>
  <p class="text-muted text-sm mt-2">Roads, hairpins, and pit stops — on the Classic 350.</p>
  <CircuitDivider />

  <div class="relative pl-16">
    <!-- road -->
    <div class="absolute left-7 top-0 bottom-0 w-1 bg-[--color-line]">
      <div id="road-fill" class="w-full bg-sage-500/60" style="height:0%"></div>
    </div>
    <!-- bike rides the road -->
    <div id="bike-rider" class="absolute -left-2 top-0 w-24 will-change-transform">
      <Bike />
    </div>

    <div class="space-y-10">
      {sorted.map((r) => (
        <article class="ride border border-[--color-line] bg-panel p-5 relative">
          <span class="absolute -left-[42px] top-6 w-4 h-4 rounded-full bg-sage-400 border-2 border-[--color-bg]"></span>
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="text-sage-200 text-lg">{r.title}</h2>
            <time class="text-xs text-muted">{new Date(r.date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time>
          </div>
          <p class="text-xs text-sage-400 mt-1">{r.source.name} → {r.destination.name} · {r.distanceKm} km</p>
          <p class="text-muted text-sm mt-2">{r.blurb}</p>
          <div class="map mt-4 h-56 border border-[--color-line]" data-ride={JSON.stringify(r)}></div>
          {r.photos && r.photos.length > 0 && (
            <div class="flex gap-2 mt-3 overflow-x-auto">
              {r.photos.map((p) => (
                <img src={p.src} alt={p.caption} loading="lazy" class="h-24 w-auto border border-[--color-line] object-cover" />
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</Base>

<script>
  // Scroll-driven bike: wheels spin + bike descends with the road.
  const bike = document.getElementById("bike-rider")!;
  const fill = document.getElementById("road-fill")!;
  const wheels = bike.querySelectorAll<SVGGElement>("[data-wheel]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  function onScroll() {
    const max = document.body.scrollHeight - innerHeight;
    const p = Math.max(0, Math.min(1, scrollY / (max || 1)));
    bike.style.top = `${p * 90}%`;
    fill.style.height = `${p * 100}%`;
    if (!reduce) { const a = scrollY * 1.2; wheels.forEach((w) => { w.style.transform = `rotate(${a}deg)`; }); }
  }
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Lazy-load Leaflet maps when each ride scrolls into view.
  function tile() {
    const dark = document.documentElement.dataset.theme !== "light";
    return dark
      ? "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
      : "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png";
  }
  async function loadLeaflet() {
    if ((window as any).L) return (window as any).L;
    await new Promise<void>((res) => { const s = document.createElement("script"); s.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"; s.onload = () => res(); document.head.appendChild(s); });
    return (window as any).L;
  }
  const io = new IntersectionObserver(async (ents, obs) => {
    for (const e of ents) {
      if (!e.isIntersecting) continue;
      obs.unobserve(e.target);
      const el = e.target as HTMLElement;
      const r = JSON.parse(el.dataset.ride!);
      const L = await loadLeaflet();
      const map = L.map(el, { scrollWheelZoom: false, attributionControl: false });
      const layer = L.tileLayer(tile(), { maxZoom: 16, subdomains: "abcd" }).addTo(map);
      addEventListener("themechange", () => layer.setUrl(tile()));
      const pts = [r.source, ...(r.pitStops || []), r.destination];
      pts.forEach((p: any, i: number) => L.circleMarker([p.lat, p.lng], { radius: i === 0 || i === pts.length - 1 ? 6 : 4, color: "#9caf88", fillColor: "#c98a4b", fillOpacity: 1 }).bindTooltip(p.name).addTo(map));
      if (r.gpx) {
        try { const xml = new DOMParser().parseFromString(await (await fetch(r.gpx)).text(), "text/xml"); const line = Array.from(xml.querySelectorAll("trkpt")).map((n) => [+n.getAttribute("lat")!, +n.getAttribute("lng")! || +n.getAttribute("lon")!]); const poly = L.polyline(line, { color: "#9caf88", weight: 3 }).addTo(map); map.fitBounds(poly.getBounds().pad(0.2)); } catch { map.fitBounds(L.latLngBounds(pts.map((p: any) => [p.lat, p.lng])).pad(0.3)); }
      } else { map.fitBounds(L.latLngBounds(pts.map((p: any) => [p.lat, p.lng])).pad(0.3)); }
      setTimeout(() => map.invalidateSize(), 60);
    }
  }, { rootMargin: "120px" });
  document.querySelectorAll(".map").forEach((m) => io.observe(m));
</script>
