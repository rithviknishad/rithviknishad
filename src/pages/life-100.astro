---
import Base from "../layouts/Base.astro";
import CircuitDivider from "../components/CircuitDivider.astro";
import { life100 } from "../data/life100";
const total = 100;
const completed = life100.filter((i) => i.done).length;
const pct = Math.round((completed / total) * 100);
---
<Base title="life-100" description="100 things Rithvik Nishad wants to do in life.">
  <div class="flex items-end justify-between gap-4">
    <h1 class="text-2xl font-bold text-sage-100">// life-100</h1>
    <span class="text-sm text-muted">{completed} / {total}</span>
  </div>
  <p class="text-muted text-sm mt-2">100 things to do before the capacitor discharges.</p>

  <div class="mt-4 h-2 w-full bg-[--color-line]">
    <div class="h-full bg-sage-400 transition-all duration-300" style={`width:${pct}%`}></div>
  </div>

  <div class="flex gap-2 mt-4 text-xs">
    <button data-filter="all" class="filter px-3 py-1 border border-sage-500 text-sage-200">all</button>
    <button data-filter="open" class="filter px-3 py-1 border border-[--color-line] text-muted">open</button>
    <button data-filter="done" class="filter px-3 py-1 border border-[--color-line] text-muted">done</button>
  </div>

  <ul id="list" class="space-y-2 mt-4">
    {life100.map((item) => (
      <li class="item flex gap-3 items-start border border-[--color-line] bg-panel p-3" data-done={item.done ? "1" : "0"}>
        <input type="checkbox" checked={item.done} disabled class="mt-1 accent-[--color-sage-400] w-4 h-4" />
        <div class="flex-1">
          <span class:list={["text-muted", item.done && "text-sage-500"]}>
            <span class="text-sage-500/50 mr-2 font-semibold">{String(item.id).padStart(3, "0")}</span>{item.text}
          </span>
          <div class="flex flex-wrap gap-x-3 mt-1 text-xs">
            {item.completedAt && (
              <span class="text-sage-400">✓ {new Date(item.completedAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</span>
            )}
            {item.link && (
              <a href={item.link} target="_blank" rel="noopener" class="text-copper hover:underline">more →</a>
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>
  <p class="text-xs text-muted mt-6">{life100.length}/100 listed.</p>
</Base>

<script>
  const items = Array.from(document.querySelectorAll<HTMLLIElement>(".item"));
  document.querySelectorAll<HTMLButtonElement>(".filter").forEach((b) => {
    b.addEventListener("click", () => {
      const f = b.dataset.filter!;
      document.querySelectorAll(".filter").forEach((x) => {
        x.classList.remove("border-sage-500", "text-sage-200");
        x.classList.add("border-[--color-line]", "text-muted");
      });
      b.classList.add("border-sage-500", "text-sage-200");
      items.forEach((li) => {
        const done = li.dataset.done === "1";
        li.style.display = f === "all" || (f === "done") === done ? "flex" : "none";
      });
    });
  });
</script>
