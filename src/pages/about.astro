---
import Base from "../layouts/Base.astro";
import CircuitDivider from "../components/CircuitDivider.astro";
---
<Base title="about" description="About Rithvik Nishad — Software & Electrical Engineer.">
  <h1 class="text-2xl font-bold text-sage-100">// about</h1>
  <CircuitDivider />
  <div class="space-y-4 text-muted leading-relaxed">
    <p class="solder pl-1">
      I'm <span class="text-sage-200">Rithvik Nishad</span>, a Software & Electrical
      Engineer. I love living at the intersection of bits and volts.
    </p>
    <p>
      By day I'm a Software Engineer at
      <span class="text-sage-300">Open Healthcare Network Foundation</span>,
      building tools that make care better.
    </p>
    <p>
      On weekends, I tinker with IoT devices — wiring up ESP32s and other
      microcontrollers into cool, sometimes pointless, always fun builds.
    </p>
  </div>
</Base>
